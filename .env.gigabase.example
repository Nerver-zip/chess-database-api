# Private restricted deployment. Keep raw-PGN retrieval disabled.
# The runtime volume and network names are those of the existing private R3
# deployment. They are kept so redeploying attaches to the same data.
OPENING_EXPLORER_ENABLE_GAME_RETRIEVAL=false
OPENING_EXPLORER_RUNTIME_VOLUME=codb-gigabase-r3-runtime
OPENING_EXPLORER_NETWORK_NAME=codb-gigabase-r3-net
OPENING_EXPLORER_NETWORK_EXTERNAL=false
OPENING_EXPLORER_READER_POOL_SIZE=16
OPENING_EXPLORER_READER_POOL_TIMEOUT_SECS=5
OPENING_EXPLORER_REQUEST_TIMEOUT_SECS=15
OPENING_EXPLORER_MAX_MOVE_PLIES=200
OPENING_EXPLORER_MEMORY_LIMIT=512m
OPENING_EXPLORER_CPU_LIMIT=2
OPENING_EXPLORER_LOG_LEVEL=info

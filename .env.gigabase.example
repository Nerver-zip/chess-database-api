# Named-volume deployment of the Gigabase R3 Masters snapshot.
# The runtime volume and network names are those of the original R3 acceptance
# environment. They are kept so redeploying attaches to the same data.
# Single-game PGN retrieval is enabled (the default) and is a supported public
# capability; see docs/LICENSING.md section 6 for the terms (non-commercial use,
# attribution). Set it to false only if you want a statistics-only service.
CHESS_DATABASE_ENABLE_GAME_RETRIEVAL=true
CHESS_DATABASE_RUNTIME_VOLUME=codb-gigabase-r3-runtime
CHESS_DATABASE_NETWORK_NAME=codb-gigabase-r3-net
CHESS_DATABASE_NETWORK_EXTERNAL=false
CHESS_DATABASE_READER_POOL_SIZE=16
CHESS_DATABASE_READER_POOL_TIMEOUT_SECS=5
CHESS_DATABASE_REQUEST_TIMEOUT_SECS=15
CHESS_DATABASE_MAX_MOVE_PLIES=200
CHESS_DATABASE_MEMORY_LIMIT=512m
CHESS_DATABASE_CPU_LIMIT=2
CHESS_DATABASE_LOG_LEVEL=info

# Named-volume deployment of the Gigabase R3 Masters snapshot.
# The runtime volume and network names are those of the original R3 acceptance
# environment. They are kept so redeploying attaches to the same data.
# Single-game PGN retrieval is enabled (the default) and is a supported public
# capability; see docs/LICENSING.md section 6 for the terms (non-commercial use,
# attribution). Set it to false only if you want a statistics-only service.
OPENING_EXPLORER_ENABLE_GAME_RETRIEVAL=true
OPENING_EXPLORER_RUNTIME_VOLUME=codb-gigabase-r3-runtime
OPENING_EXPLORER_NETWORK_NAME=codb-gigabase-r3-net
OPENING_EXPLORER_NETWORK_EXTERNAL=false
OPENING_EXPLORER_READER_POOL_SIZE=16
OPENING_EXPLORER_READER_POOL_TIMEOUT_SECS=5
OPENING_EXPLORER_REQUEST_TIMEOUT_SECS=15
OPENING_EXPLORER_MAX_MOVE_PLIES=200
OPENING_EXPLORER_MEMORY_LIMIT=512m
OPENING_EXPLORER_CPU_LIMIT=2
OPENING_EXPLORER_LOG_LEVEL=info

/target
**/*.rs.bk
# Data directories and archives
data/
raw/
downloads/
*.zst
*.pgn.zst
*.db
*.sqlite
*.sqlite3
*.rocksdb
*.mdb

# Allow small test fixtures
!fixtures/
!fixtures/*.pgn

# Temporary files and scratch
scratch/
tmp/
*.log
__pycache__/
*.pyc

# Benchmark artifacts that exceed limits
benchmarks/data/

# Runtime datasets (host paths must contain the stable release roots).
CODB_DATA_DIR=./data
CODB_MASTERS_RELEASE_DIR=./data/releases/masters-otb
CODB_ELITE_RELEASE_DIR=./data/releases/elite-online

# The default network is managed by this Compose project. Set external=true only
# after creating CODB_NETWORK_NAME with docker network create.
CODB_NETWORK_NAME=codb-shared
CODB_NETWORK_EXTERNAL=false

# Bounded runtime settings.
CODB_READER_POOL_SIZE=16
CODB_READER_POOL_TIMEOUT_SECS=5
CODB_REQUEST_TIMEOUT_SECS=15
CODB_MAX_MOVE_PLIES=200
# Raw PGN retrieval is enabled for the approved baseline releases. Disable it for
# restricted datasets that permit derived position statistics but not PGN delivery.
CODB_ENABLE_GAME_RETRIEVAL=true
CODB_MEMORY_LIMIT=512m
CODB_CPU_LIMIT=2
CODB_LOG_LEVEL=info

# Used only with compose.codb.debug.yaml.
CODB_DEBUG_PORT=8081

# Runtime datasets (host paths must contain the stable release roots).
CHESS_DATABASE_DATA_DIR=./data
CHESS_DATABASE_MASTERS_RELEASE_DIR=./data/releases/masters-otb
CHESS_DATABASE_ELITE_RELEASE_DIR=./data/releases/elite-online

# The default network is managed by this Compose project. Set external=true only
# after creating CHESS_DATABASE_NETWORK_NAME with docker network create.
CHESS_DATABASE_NETWORK_NAME=opening-explorer-shared
CHESS_DATABASE_NETWORK_EXTERNAL=false

# Bounded runtime settings.
CHESS_DATABASE_READER_POOL_SIZE=16
CHESS_DATABASE_READER_POOL_TIMEOUT_SECS=5
CHESS_DATABASE_REQUEST_TIMEOUT_SECS=15
CHESS_DATABASE_MAX_MOVE_PLIES=200
# Single-game PGN retrieval is enabled by default and is a supported public capability
# (see docs/LICENSING.md section 6). Set it to false for a statistics-only service.
CHESS_DATABASE_ENABLE_GAME_RETRIEVAL=true
CHESS_DATABASE_MEMORY_LIMIT=512m
CHESS_DATABASE_CPU_LIMIT=2
CHESS_DATABASE_LOG_LEVEL=info

# Used only with compose.debug.yaml.
CHESS_DATABASE_DEBUG_PORT=8081

# Search operates on enriched snapshots. Masters discovery requires explicit operator enablement.
CHESS_DATABASE_MASTERS_DISCOVERY=false
CHESS_DATABASE_MASTERS_GAME_METADATA=false
CHESS_DATABASE_ELITE_DISCOVERY=true
CHESS_DATABASE_ELITE_GAME_METADATA=true
CHESS_DATABASE_SEARCH_CONCURRENCY=2
CHESS_DATABASE_DEEP_VALIDATE_ON_STARTUP=false
CHESS_DATABASE_SEARCH_DEADLINE_MS=2000
CHESS_DATABASE_SEARCH_MAX_PAGE_SIZE=100

# Runtime datasets (host paths must contain the stable release roots).
OPENING_EXPLORER_DATA_DIR=./data
OPENING_EXPLORER_MASTERS_RELEASE_DIR=./data/releases/masters-otb
OPENING_EXPLORER_ELITE_RELEASE_DIR=./data/releases/elite-online

# The default network is managed by this Compose project. Set external=true only
# after creating OPENING_EXPLORER_NETWORK_NAME with docker network create.
OPENING_EXPLORER_NETWORK_NAME=opening-explorer-shared
OPENING_EXPLORER_NETWORK_EXTERNAL=false

# Bounded runtime settings.
OPENING_EXPLORER_READER_POOL_SIZE=16
OPENING_EXPLORER_READER_POOL_TIMEOUT_SECS=5
OPENING_EXPLORER_REQUEST_TIMEOUT_SECS=15
OPENING_EXPLORER_MAX_MOVE_PLIES=200
# Raw PGN retrieval is enabled for the approved baseline releases. Disable it for
# restricted datasets that permit derived position statistics but not PGN delivery.
OPENING_EXPLORER_ENABLE_GAME_RETRIEVAL=true
OPENING_EXPLORER_MEMORY_LIMIT=512m
OPENING_EXPLORER_CPU_LIMIT=2
OPENING_EXPLORER_LOG_LEVEL=info

# Used only with compose.debug.yaml.
OPENING_EXPLORER_DEBUG_PORT=8081

# Private restricted deployment. Keep raw-PGN retrieval disabled.
CODB_ENABLE_GAME_RETRIEVAL=false
CODB_RUNTIME_VOLUME=codb-gigabase-r3-runtime
CODB_NETWORK_NAME=codb-gigabase-r3-net
CODB_NETWORK_EXTERNAL=false
CODB_READER_POOL_SIZE=16
CODB_READER_POOL_TIMEOUT_SECS=5
CODB_REQUEST_TIMEOUT_SECS=15
CODB_MAX_MOVE_PLIES=200
CODB_MEMORY_LIMIT=512m
CODB_CPU_LIMIT=2
CODB_LOG_LEVEL=info

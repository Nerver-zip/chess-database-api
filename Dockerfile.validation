FROM rust:1.100.0-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config libzstd-dev \
       python3 python3-yaml git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .
RUN ./scripts/validate.sh
